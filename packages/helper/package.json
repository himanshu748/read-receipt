{
  "name": "@rr/helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "rr-helper": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "gen-replay": "node ./scripts/gen-replay.mjs"
  },
  "dependencies": {
    "@rr/protocol": "0.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
